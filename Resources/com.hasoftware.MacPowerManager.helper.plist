<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hasoftware.MacPowerManager.helper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.hasoftware.MacPowerManager.helper</string>
    </array>
    <key>MachServices</key>
    <dict>
        <key>com.hasoftware.MacPowerManager.helper</key>
        <true/>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <!-- Background bị macOS hạn chế CPU/timer; Adaptive giữ vòng điều khiển đúng nhịp. -->
    <key>ProcessType</key>
    <string>Adaptive</string>
    <!-- Hiển thị tên app trong System Settings → General → Login Items. -->
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.hasoftware.MacPowerManager</string>
    </array>
</dict>
</plist>
