	<key>Pin vẫn nhận dòng sạc sau %lld giây kể từ khi chặn sạc.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Pin vẫn nhận dòng sạc sau %#@seconds@ kể từ khi chặn sạc.</string>
